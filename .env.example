# Copy to ".env" for local development. On Render, set these as real
# environment variables on the service instead (see render.yaml — they're
# marked sync:false so Render prompts you for them rather than storing
# them in git).

PORT=3000

# From Supabase: Project Settings → API. SUPABASE_SERVICE_ROLE_KEY
# bypasses Row Level Security — never expose it to the mobile app or
# any client bundle, only this backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From Stripe: Developers → API keys / Webhooks. Leave blank until
# Phase 2 payments work begins — the webhook route responds 501 until
# both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
