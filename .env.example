# Copy to ".env" for local development. On Render, set these as real
# environment variables on the service instead (see render.yaml — they're
# marked sync:false so Render prompts you for them rather than storing
# them in git).

PORT=3000

# From Supabase: Project Settings → API. SUPABASE_SERVICE_ROLE_KEY
# bypasses Row Level Security — never expose it to the mobile app or
# any client bundle, only this backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From console.anthropic.com → API Keys. Powers Phase 3 (smart
# replies, summaries, translation) — those routes respond 501 until
# this is set. ANTHROPIC_MODEL is optional; defaults to a current
# Claude model if left blank.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# A random string only this backend and the Postgres trigger know —
# see the bottom of supabase/migrations/0003_groups_voice_push.sql for
# the matching ALTER DATABASE command. Generate with `openssl rand -hex 32`
# or similar. Push notifications 501 until this is set.
INTERNAL_WEBHOOK_SECRET=

# LiveKit SFU — required before group calls or creator LIVE can carry media.
# Use a reachable LiveKit server URL (wss://...), API key, and API secret.
# Keep the API secret server-side only; never add it to EXPO_PUBLIC_* vars.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
