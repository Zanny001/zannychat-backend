# Copy to ".env" for local development. On Render, set these as real
# environment variables on the service instead (see render.yaml — they're
# marked sync:false so Render prompts you for them rather than storing
# them in git).

PORT=3000

# Optional exact browser origins for local/preview testing. Comma-separated;
# keep production entries narrow (for example http://localhost:4173).
CORS_EXTRA_ORIGINS=

# From Supabase: Project Settings → API. SUPABASE_SERVICE_ROLE_KEY
# bypasses Row Level Security — never expose it to the mobile app or
# any client bundle, only this backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From console.anthropic.com → API Keys. Powers Phase 3 (smart
# replies, summaries, translation) — those routes respond 501 until
# this is set. ANTHROPIC_MODEL is optional; defaults to a current
# Claude model if left blank.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# A random string only this backend and the Postgres trigger know —
# see the bottom of supabase/migrations/0003_groups_voice_push.sql for
# the matching ALTER DATABASE command. Generate with `openssl rand -hex 32`
# or similar. Push notifications 501 until this is set.
INTERNAL_WEBHOOK_SECRET=

# LiveKit SFU — required before group calls or creator LIVE can carry media.
# Use a reachable LiveKit server URL (wss://...), API key, and API secret.
# Keep the API secret server-side only; never add it to EXPO_PUBLIC_* vars.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Play one-time Sparks purchase verification.
# Keep billing disabled until the Play Console products, API access, and
# a real license-tester purchase/refund cycle have been verified.
LIVE_GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.zannychat.app
# Paste the complete service-account JSON into the Render secret field.
# Never commit the JSON or expose it in EXPO_PUBLIC_* variables.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Required only after Google Play RTDN is configured to publish to Pub/Sub.
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Apple StoreKit 2 server verification (keep disabled until App Store Connect and sandbox acceptance)
LIVE_APPLE_IAP_ENABLED=false
APPLE_APP_BUNDLE_ID=com.zannychat.app
APPLE_APP_ID=
# Comma-separated base64 DER Apple Root CA certificates from Apple PKI.
APPLE_ROOT_CA_CERTIFICATES_BASE64=
# Sandbox transaction fulfilment is allowed only when NODE_ENV is not production.
APPLE_IAP_ALLOW_SANDBOX=false
